{
  "name": "solares-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run test:run && npm run build",
    "championships:sync": "tsx --tsconfig tsconfig.app.json scripts/sync-championships-data.ts",
    "championships:sync:check": "tsx --tsconfig tsconfig.app.json scripts/sync-championships-data.ts --check",
    "championships:assets": "tsx --tsconfig tsconfig.app.json scripts/championships/process-championship-assets.ts",
    "championships:assets:check": "tsx --tsconfig tsconfig.app.json scripts/championships/process-championship-assets.ts --check",
    "goals:inspect": "tsx --tsconfig tsconfig.app.json scripts/inspect-goals.ts",
    "goals:upload:dry": "tsx --tsconfig tsconfig.app.json scripts/upload-goals-to-cloudinary.ts --dry-run",
    "goals:upload": "tsx --tsconfig tsconfig.app.json scripts/upload-goals-to-cloudinary.ts",
    "goals:verify": "tsx --tsconfig tsconfig.app.json scripts/goals/verify-goals.ts",
    "goals:duplicates": "tsx --tsconfig tsconfig.app.json scripts/find-duplicate-goals.ts",
    "goals:prune": "tsx --tsconfig tsconfig.app.json scripts/prune-cloudinary-goals.ts",
    "goals:prune:apply": "tsx --tsconfig tsconfig.app.json scripts/prune-cloudinary-goals.ts --confirm",
    "goals:sync": "npm run goals:inspect && npm run goals:upload && npm run goals:verify",
    "content:check": "npm run championships:assets:check && npm run goals:inspect",
    "content:sync": "npm run championships:sync && npm run championships:assets && npm run goals:sync",
    "assets:women-and-mixed": "tsx scripts/prepare-women-and-mixed-assets.ts",
    "assets:screenshots": "tsx --tsconfig tsconfig.app.json scripts/media/capture-screenshots.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "p-limit": "^7.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
